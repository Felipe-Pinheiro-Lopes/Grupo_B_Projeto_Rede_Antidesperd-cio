# ==========================================
# Git Ignore — Monorepo (Front & Back)
# Rede Antidesperdício
# ==========================================

# Dependencies (Recursivo para Front e Back)
node_modules/
.pnp/
.pnp.js

# Production & Builds
.next/
out/
build/
dist/

# Environment Variables & Secrets
.env
.env*.local
*.env
*.pem

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# SQLite Locks & Journals (Permite versionar .sqlite/.db, mas ignora locks temporários)
*.db-journal
*.sqlite-journal
*.sqlite3-journal
*.db-wal
*.db-shm

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/

# TypeScript
*.tsbuildinfo
next-env.d.ts
